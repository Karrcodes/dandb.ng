{
    "rewrites": [
        {
            "source": "/",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": ".*(Mobile|Android|iPhone|iPad|iPod|webOS|BlackBerry|IEMobile|Opera Mini).*"
                }
            ],
            "destination": "/mobile/index.html"
        },
        {
            "source": "/",
            "destination": "/new-site/index.html"
        }
    ]
}